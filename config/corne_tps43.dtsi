#include <dt-bindings/zmk/input_transform.h>
#include <input/processors/transform.dtsi>

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        tps43_split: input_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    tps43_listener: tps43_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&tps43_split>;
        // Physical test after axis swap: horizontal correct, vertical reversed.
        // Swap first, then invert only the resulting cursor Y axis.
        input-processors = <&zip_xy_transform
                            (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>,
                           <&zip_scroll_transform INPUT_TRANSFORM_XY_SWAP>;
    };
};
