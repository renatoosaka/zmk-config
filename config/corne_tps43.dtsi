#include <dt-bindings/zmk/input_transform.h>
#include <input/processors/transform.dtsi>

/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        tps43_split: input_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    tps43_listener: tps43_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&tps43_split>;
        // Physical test: with flip-x on the trackpad, pointer axes already match.
        // Up moved the cursor left and right moved it up, so the old swap
        // plus Y invert is removed. Scroll keeps its own axis swap.
        input-processors = <&zip_scroll_transform INPUT_TRANSFORM_XY_SWAP>;
    };
};
